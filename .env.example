# ===== প্রয়োজনীয় (Required) =====
# Discord bot token (Discord Developer Portal -> Bot -> Token)
TOKEN=your_bot_token_here

# MongoDB connection URI (https://cloud.mongodb.com -> Database -> Connect)
MONGODB_URI=your_mongodb_uri_here

# ===== ঐচ্ছিক (Optional) =====
# Command prefix for message commands (default: !)
#BOT_PREFIX=!

# ===== Lavalink (music server) =====
# ⚠️ মিউজিক/VC join কাজ করার জন্য একটা Lavalink সার্ভার লাগবে।
# নিজের নোড থাকলে নিচের ভ্যারিয়েবলগুলো সেট করো।
# সেট না করলে বট পাবলিক ফলব্যাক নোড ব্যবহার করবে (কম স্থিতিশীল)।
#
# LAVALINK_HOST=lavalink.example.com
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=false
#
# উদাহরণ (SSL সহ পাবলিক নোড):
# LAVALINK_HOST=lavalink.nazha.online
# LAVALINK_PORT=443
# LAVALINK_PASSWORD=nazhafreelava
# LAVALINK_SECURE=true
